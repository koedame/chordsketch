# Auto-generated by the Swift Package workflow (swift.yml). Do not edit manually.
Pod::Spec.new do |s|
  s.name         = 'ChordSketch'
  s.version      = '{{VERSION}}'
  s.summary      = 'ChordPro file format parser and renderer'
  s.description  = <<-DESC
    ChordSketch is a Rust implementation of the ChordPro file format.
    It parses .cho files and renders them to text, HTML, or PDF output.
    This pod provides the Swift API (`import ChordSketch`) on top of the
    pre-built chordsketchFFI XCFramework, for iOS and macOS.
  DESC
  s.homepage     = 'https://github.com/koedame/chordsketch'
  s.license      = { :type => 'MIT', :file => 'LICENSE' }
  s.author       = { 'koedame' => 'koedame@users.noreply.github.com' }

  # The tag holds the UniFFI-generated Swift bindings (committed by the
  # `pin` job, ADR-0080) but not the XCFramework, which is a release asset.
  # `prepare_command` fetches it and refuses a zip whose SHA-256 is not the
  # one the tag's Package.swift pins, so the binary is the one the bindings
  # were generated for.
  s.source       = {
    :git => 'https://github.com/koedame/chordsketch.git',
    :tag => 'v{{VERSION}}'
  }
  s.prepare_command = <<-'CMD'
    set -euo pipefail
    curl --fail --silent --show-error --location \
      --output chordsketch-xcframework.zip \
      'https://github.com/koedame/chordsketch/releases/download/v{{VERSION}}/chordsketch-xcframework.zip'
    echo '{{SHA256}}  chordsketch-xcframework.zip' | shasum -a 256 -c -
    unzip -q chordsketch-xcframework.zip
    rm chordsketch-xcframework.zip
  CMD

  s.ios.deployment_target = '15.0'
  s.osx.deployment_target = '12.0'
  s.swift_version = '5.9'

  s.source_files = 'packages/swift/Sources/ChordSketch/*.swift'
  s.vendored_frameworks = 'chordsketchFFI.xcframework'
  # chordsketch-render-pdf depends on flate2, which uses the system zlib on
  # Apple platforms (the same setting as Package.swift's `linkedLibrary`).
  s.libraries = 'z'

  s.test_spec 'Tests' do |t|
    t.source_files = 'packages/swift/Tests/*.swift'
  end
end
