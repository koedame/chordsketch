  <name>ChordSketch</name>
  <summary>Write chord sheets with a live preview</summary>
  <developer id="io.github.koedame">
    <name>koedame</name>
  </developer>

  <description>
    <p>
      ChordSketch is an editor for chord sheets: lyrics with the chords to play
      above them. Type a song in the ChordPro format and the formatted sheet
      appears next to it as you write.
    </p>
    <ul>
      <li>Transpose a song, or set a capo, and every chord follows</li>
      <li>Chord diagrams for guitar, ukulele and keyboard</li>
      <li>Export to PDF or HTML</li>
      <li>Open and edit iReal Pro charts as a bar grid</li>
      <li>Listen to a chord, the key of the song, or a metronome at its tempo</li>
    </ul>
  </description>

  <launchable type="desktop-id">io.github.koedame.chordsketch.desktop</launchable>

