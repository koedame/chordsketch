{
  "name": "@chordsketch/vue",
  "version": "0.1.0",
  "description": "Vue 3 components for embedding ChordPro previews, editors and chord diagrams, powered by @chordsketch/wasm",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/koedame/chordsketch.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/koedame/chordsketch",
  "bugs": {
    "url": "https://github.com/koedame/chordsketch/issues"
  },
  "keywords": [
    "chordpro",
    "music",
    "chord",
    "parser",
    "lyrics",
    "vue",
    "vue3",
    "vue-component",
    "composition-api",
    "wasm",
    "webassembly"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node -e \"require('fs').copyFileSync('src/styles.css','dist/styles.css')\"",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@chordsketch/wasm-export": "^0.5.0",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@chordsketch/wasm-export": {
      "optional": true
    }
  },
  "dependencies": {
    "@chordsketch/wasm": "^0.5.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "vue": "^3.5.13"
  },
  "sideEffects": [
    "./dist/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
