{
  "name": "@chordsketch/chordpro-lite",
  "version": "0.1.0",
  "description": "Dependency-free ChordPro helpers — format detection, lyric extraction, and preview sampling — with no WebAssembly runtime",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/koedame/chordsketch.git",
    "directory": "packages/chordpro-lite"
  },
  "homepage": "https://github.com/koedame/chordsketch",
  "bugs": {
    "url": "https://github.com/koedame/chordsketch/issues"
  },
  "keywords": [
    "chordpro",
    "music",
    "chord",
    "parser",
    "lyrics",
    "ireal-pro",
    "format-detection",
    "zero-dependency"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
