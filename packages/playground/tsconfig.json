{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@chordsketch/wasm": ["../npm/web/chordsketch_wasm"],
      "@chordsketch/react": ["../react/src/index.ts"],
      "@chordsketch/react/styles.css": ["../react/src/styles.css"],
      "@chordsketch/react-ui": ["../react-ui/src/index.ts"],
      "@chordsketch/react-ui/styles.css": ["../react-ui/src/styles.css"],
      "@chordsketch/ui-irealb-editor": ["../ui-irealb-editor/src/index.ts"],
      "@chordsketch/ui-irealb-editor/style.css": ["../ui-irealb-editor/src/style.css"],
      "@chordsketch/vue": ["../vue/src/index.ts"],
      "@chordsketch/vue/styles.css": ["../vue/src/styles.css"],
      "@chordsketch/svelte": ["../svelte/src/index.ts"],
      "@chordsketch/svelte/styles.css": ["../svelte/src/styles.css"]
    }
  },
  "include": [
    "src",
    "tests",
    "tests-e2e",
    "vitest.config.ts",
    "playwright.config.ts",
    "../react/src",
    "../react-ui/src",
    "../ui-irealb-editor/src",
    // `../svelte/src` is deliberately NOT listed here, unlike its Vue
    // sibling above. Vue's index.ts re-exports only from `.ts` files
    // (`defineComponent` render functions); Svelte's re-exports named
    // members (`TRANSPOSE_DEFAULT_MAX`, `TRANSPOSE_DEFAULT_MIN`,
    // `PDF_EXPORT_DEFAULT_LABEL`) straight from `.svelte` SFCs, and
    // `src/framework-demo.d.ts`'s `declare module '*.svelte'` shim
    // only models a default export. Adding this directory to
    // `include` makes tsc treat `../svelte/src/index.ts` as a root
    // file and fails with TS2614 on those named re-exports. The
    // package's own `svelte-check` already typechecks this directory
    // in full; that coverage is what this line would otherwise
    // duplicate.
    "../vue/src"
  ]
}
