{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "ChordPro",
    "fileTypes": ["cho", "chordpro", "chopro"],
    "scopeName": "source.chordpro",
    "patterns": [
        {"include": "#comment"},
        {"include": "#delegate-block"},
        {"include": "#directive"},
        {"include": "#chord"}
    ],
    "repository": {
        "comment": {
            "name": "comment.line.number-sign.chordpro",
            "match": "^(#)(.*)$",
            "captures": {
                "1": {"name": "punctuation.definition.comment.chordpro"},
                "2": {"name": "comment.line.chordpro"}
            }
        },
        "delegate-block": {
            "comment": "Sections whose body is verbatim: no chords, no directives. The environments listed here are the ones `Parser::verbatim_end_for` in `crates/chordpro/src/parser.rs` treats that way, plus the `sot` / `sog` / `eot` / `eog` aliases; every other section name (a verse, a chorus, `{start_of_outro}`) is an ordinary section and falls through to `#directive` so its lines keep their chords. Keep this list and the parser's in step.",
            "begin": "(?i)({)((?:start_of_(?:abc|grid|ly|musicxml|svg|tab|textblock)|sot|sog)\\b)(?:\\s*(:)\\s*([^{}]*?))?\\s*(})",
            "beginCaptures": {
                "1": {"name": "punctuation.definition.directive.begin.chordpro"},
                "2": {"name": "keyword.control.directive.chordpro"},
                "3": {"name": "punctuation.separator.directive.chordpro"},
                "4": {"name": "string.unquoted.directive-value.chordpro"},
                "5": {"name": "punctuation.definition.directive.end.chordpro"}
            },
            "end": "(?i)({)((?:end_of_(?:abc|grid|ly|musicxml|svg|tab|textblock)|eot|eog)\\b)(?:\\s*(:)\\s*([^{}]*?))?\\s*(})",
            "endCaptures": {
                "1": {"name": "punctuation.definition.directive.begin.chordpro"},
                "2": {"name": "keyword.control.directive.chordpro"},
                "3": {"name": "punctuation.separator.directive.chordpro"},
                "4": {"name": "string.unquoted.directive-value.chordpro"},
                "5": {"name": "punctuation.definition.directive.end.chordpro"}
            },
            "contentName": "markup.raw.block.chordpro"
        },
        "directive": {
            "match": "({)([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s*(:)\\s*((?:[^{}]*?)))?\\s*(})",
            "captures": {
                "1": {"name": "punctuation.definition.directive.begin.chordpro"},
                "2": {"name": "keyword.control.directive.chordpro"},
                "3": {"name": "punctuation.separator.directive.chordpro"},
                "4": {"name": "string.unquoted.directive-value.chordpro"},
                "5": {"name": "punctuation.definition.directive.end.chordpro"}
            }
        },
        "chord": {
            "match": "(\\[)([^\\[\\]]*)(\\])",
            "captures": {
                "1": {"name": "punctuation.definition.chord.begin.chordpro"},
                "2": {"name": "entity.name.chord.chordpro"},
                "3": {"name": "punctuation.definition.chord.end.chordpro"}
            }
        }
    }
}
